auto-install-peers=false
strict-peer-dependencies=false

# Hoist Expo and React Native packages to the workspace root node_modules so
# CocoaPods / expo-modules-autolinking can resolve them via plain Node
# module resolution instead of traversing pnpm's virtual store symlinks.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native*
